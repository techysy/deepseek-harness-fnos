#!/bin/bash
# install_callback — 配置 DeepSeek Harness (dsh) fnOS 应用
# 含 FN Connect 域名 (trusted_hosts.conf) 保存 + settings 前端 patch (memory->host)
# 离线优先: 若 fpk 内置 node_modules 则免联网; 否则在线 npm install (针对当前架构编译)
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-dsh}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -z "${APP_VOL}" ]; then
        APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi
# APP_VOL 由 APP_DIR 提取 (同卷), 不写死 /vol4
LOG="${DATA_DIR}/install.log"
DSH_HOME="${DATA_DIR}/dsh_home"
# 离线 dsh 包 (随 fpk 打包, 安装后解压在 ${TRIM_APPDEST}/server)
DSH_OFFLINE="${APP_DIR}/server/node_modules/@deepseek-ai/dsh/lib/bin.js"

mkdir -p "${DATA_DIR}" "${DSH_HOME}"
echo "[$(date '+%F %T')] install_callback start (user=$(id -un) uid=$(id -u))" >> "${LOG}"

# ── 初始化 DSH_HOME ──
init_dsh_home() {
    mkdir -p "${DSH_HOME}/profiles" "${DSH_HOME}/logs" 2>/dev/null
    if [ ! -f "${DSH_HOME}/.env" ]; then
        {
            echo "DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY:-}"
        } > "${DSH_HOME}/.env" 2>/dev/null
    fi
    echo "[$(date '+%F %T')] dsh_home initialized at ${DSH_HOME}" >> "${LOG}"
}

# 保存安装向导配置到 .env (区分首次/升级, 避免升级清空)
if [ ! -f "${DSH_HOME}/.env" ] || [ -n "${wizard_deepseek_api_key:-}" ]; then
    cat > "${DSH_HOME}/.env" <<EOF
DEEPSEEK_API_KEY="${wizard_deepseek_api_key:-}"
EOF
    chmod 600 "${DSH_HOME}/.env" 2>/dev/null
    echo "[$(date '+%F %T')] saved wizard config to .env" >> "${LOG}"
fi

# 保存安装向导填的代理到 proxy.conf (IP+端口拼成 http://IP:port; 都填才写, 留空默认不走代理)
if [ -n "${wizard_proxy_ip:-}" ] && [ -n "${wizard_proxy_port:-}" ]; then
    printf 'PROXY=http://%s:%s\n' "${wizard_proxy_ip}" "${wizard_proxy_port}" > "${DSH_HOME}/proxy.conf" 2>/dev/null
    chmod 600 "${DSH_HOME}/proxy.conf" 2>/dev/null
    chown "${APP_NAME:-dsh}:${APP_NAME:-dsh}" "${DSH_HOME}/proxy.conf" 2>/dev/null || true
    echo "[$(date '+%F %T')] saved wizard proxy to proxy.conf: http://${wizard_proxy_ip}:${wizard_proxy_port}" >> "${LOG}"
fi

# 保存安装向导填的 FN Connect ID 自动拼信任域到 trusted_hosts.conf (每行一个 hostname; 留空保留当前值)
if [ -n "${wizard_fnos_id:-}" ]; then
    FN_ID="$(printf '%s' "${wizard_fnos_id}" | tr -d '[:space:]' | sed 's#^https\?://##; s#/$##; s#\.fnos\.net$##')"
    if [ -n "${FN_ID}" ]; then
        {
            printf '%s\n' "${FN_ID}.fnos.net"
            printf '%s\n' "dsh.${FN_ID}.fnos.net"
            printf '%s\n' "fnos.net"
        } > "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null
        chmod 600 "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null
        chown "${APP_NAME:-dsh}:${APP_NAME:-dsh}" "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null || true
        echo "[$(date '+%F %T')] saved wizard FN ID to trusted_hosts.conf: ${FN_ID}.fnos.net + dsh.${FN_ID}.fnos.net + fnos.net" >> "${LOG}"
    else
        echo "[$(date '+%F %T')] wizard_fnos_id empty after normalize; keep current trusted_hosts.conf" >> "${LOG}"
    fi
else
    echo "[$(date '+%F %T')] wizard_fnos_id empty; keep current trusted_hosts.conf" >> "${LOG}"
fi

# 保存安装向导填的自定义域名 (DDNS) 到 trusted_hosts.conf (追加, 不覆盖 FN ID 生成)
if [ -n "${wizard_custom_domain:-}" ]; then
    CUSTOM_DOMAIN="$(printf '%s' "${wizard_custom_domain}" | tr -d '[:space:]' | sed -e 's#^https\?://##' -e 's#/$##')"
    if [ -n "${CUSTOM_DOMAIN}" ]; then
        touch "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null
        printf '%s\n' "${CUSTOM_DOMAIN}" >> "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null
        chmod 600 "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null
        chown "${APP_NAME:-dsh}:${APP_NAME:-dsh}" "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null || true
        echo "[$(date '+%F %T')] saved wizard custom domain to trusted_hosts.conf: ${CUSTOM_DOMAIN}" >> "${LOG}"
    fi
fi

# 检查离线 dsh 包是否存在 (随 fpk 打包); 若无则在线安装 (针对当前架构编译原生模块)
if [ ! -f "${DSH_OFFLINE}" ]; then
    echo "[$(date '+%F %T')] WARN: offline dsh package not found; online npm install (针对当前架构编译)..." >> "${LOG}"
    # 定位 nodejs_v24 (优先 fnOS 标准软链 /var/apps/<dep>/target, fallback 应用卷) 并加入 PATH
    NODE_DIR=""
    for cand in /var/apps/nodejs_v24/target/bin "${APP_VOL}/@appcenter/nodejs_v24/bin"; do
        [ -x "$cand/node" ] && NODE_DIR="$cand" && break
    done
    if [ -n "${NODE_DIR}" ]; then
        export PATH="${NODE_DIR}:${PATH}"
        # 低内存设备 (R2S 等 1GB) 防 OOM: 单线程编译 + 限制 node 堆内存
        export npm_config_jobs=1
        export NODE_OPTIONS="--max-old-space-size=512"
        # npm 缓存目录: 部分用户 HOME 不存在 (如 /home/admin), 改到数据区
        mkdir -p "${DATA_DIR}/.npm" 2>/dev/null
        export HOME="${DATA_DIR}"
        echo "[$(date '+%F %T')] using node dir: ${NODE_DIR} (jobs=1, heap=512M)" >> "${LOG}"
        ( cd "${APP_DIR}/server" && npm install @deepseek-ai/dsh@^0.1.0-rc.6 >> "${LOG}" 2>&1 )
        echo "[$(date '+%F %T')] online npm install exit=$?" >> "${LOG}"
        if [ ! -f "${DSH_OFFLINE}" ]; then
            echo "[$(date '+%F %T')] ERROR: online install did not produce ${DSH_OFFLINE}" >> "${LOG}"
        fi
    else
        echo "[$(date '+%F %T')] ERROR: nodejs_v24 not found; cannot install dsh online" >> "${LOG}"
    fi
else
    echo "[$(date '+%F %T')] offline dsh package OK: ${DSH_OFFLINE}" >> "${LOG}"
fi

# ── 应用 settings 前端 patch (memory->host) ──
# 非 loopback (FN Connect 域名) 访问时, dsh 前端默认用 memory 模式读配置导致插件配置空白.
# patch 脚本将 dsh-client-ui-settings(-models) 的 "isLoopback ? \"host\" : \"memory\"" 改为固定 "host".
PATCH_SCRIPT="$(dirname "$0")/patch_settings_memory.py"
if [ -f "${PATCH_SCRIPT}" ]; then
    echo "[$(date '+%F %T')] applying settings memory->host patch..." >> "${LOG}"
    python3 "${PATCH_SCRIPT}" >> "${LOG}" 2>&1
    echo "[$(date '+%F %T')] settings patch applied (exit=$?)" >> "${LOG}"
else
    echo "[$(date '+%F %T')] WARN: patch script not found at ${PATCH_SCRIPT}" >> "${LOG}"
fi

# ── 检测 g++/编译工具链 (node-pty 等 native 模块如需重建时依赖) ──
# dsh 含原生模块 (node-pty 等), 若离线包在低 glibc 环境构建且 NAS 需要重建, 缺 g++ 会静默失败.
# 这里主动检测并在缺失时给出清晰提示, 避免"安装成功但 dsh 起不来"的困惑.
if command -v g++ >/dev/null 2>&1; then
    echo "[$(date '+%F %T')] build-essential OK: g++ $(g++ --version 2>/dev/null | head -1)" >> "${LOG}"
else
    echo "[$(date '+%F %T')] WARN: g++ NOT FOUND — 若 dsh 的 node-pty 等原生模块需在 NAS 重建编译, 请先安装 build-essential:  ssh 到 NAS 执行 'sudo apt install -y build-essential'。" >> "${LOG}"
fi

echo "[$(date '+%F %T')] install_callback done" >> "${LOG}"
init_dsh_home
exit 0
