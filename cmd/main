#!/bin/bash
# cmd/main — DeepSeek Harness (dsh) fnOS 应用生命周期脚本
# fnOS 生命周期: install 由 install_callback 处理; 本脚本处理 start/stop/status/restart
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-dsh}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录: 优先 TRIM_PKGVAR (fnOS 注入). 兜底: 从 fnOS home 软链 (/volX/@apphome/<app>) 推导卷,
# 或从 APP_DIR 推导; 不写死具体卷. (某些 fnOS 部署 APP_DIR=/var/apps/<app> 且无 TRIM_PKGVAR)
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -z "${APP_VOL}" ]; then
        APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi


# ── 数据落点: 工作空间/会话放 @appshare, 凭据留 @appdata (issue #2 收敛方案) ──
# 为什么拆开:
#   @appshare 是 config/resource `data-share` 声明的"共享目录", 用户能在飞牛文件
#   管理器里直接看到、也能 SMB 共享 (issue #2 的原始诉求 —— 随时查看/导入物料)。
#   **代价**: 该目录使用 Windows ACL 且对用户可见, 因此凭据类文件 (.env API Key /
#   .credentials.yaml / proxy.conf) 不能放里面, 留在 @appdata 数据区。
#   卸载时: fnOS 会清理 @appdata/<app>, 但**不会**清理共享目录 —— 所以工作空间
#   (会话记录、dsh 工作文件) 卸载后仍在, 凭据随应用一起清掉 (重装重填, 符合预期)。
# 落点解析: 优先 fnOS 注入的 TRIM_DATA_SHARE_PATHS (官方推荐, 取第一个条目),
# 否则用应用目录下的 share 软链 (/var/apps/<app>/share/<name>), 再否则回退数据区。
SHARE_DIR=""
fn_resolve_share() {
    local cand
    # ① 官方: TRIM_DATA_SHARE_PATHS 冒号分隔, 取第一个
    if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
        cand="$(printf '%s' "${TRIM_DATA_SHARE_PATHS}" | cut -d: -f1)"
        [ -n "${cand}" ] && SHARE_DIR="${cand}" && return 0
    fi
    # ② 应用目录 share 软链 (config/resource 声明名 dsh)
    for cand in "${APP_DIR}/share/${APP_NAME}" "${APP_DIR}/share/data" "${APP_DIR}/share"; do
        [ -d "${cand}" ] && SHARE_DIR="${cand}" && return 0
    done
    # ③ 兜底: 按卷推导 @appshare (声明缺失时的容错)
    if [ -n "${APP_VOL:-}" ] && [ -d "${APP_VOL}/@appshare" ]; then
        SHARE_DIR="${APP_VOL}/@appshare/${APP_NAME}"
    fi
    return 0
}
fn_resolve_share

# 端口: dsh web 绑 0.0.0.0 (经 cordis.patch.yml 覆盖 webserver host, 绕过 CLI 安全校验)
# 局域网/Tailscale 可直接访问 NAS_IP:28000; 同时 proxy.py 经统一网关 /app/dsh 暴露
DSH_PORT="${TRIM_SERVICE_PORT:-28000}"
# WORK_HOME: 工作空间/会话落点 (@appshare 内), 迁移后 dsh 的 HOME 指向它
# HOME_DIR:  **凭据**落点 (@appdata, 不对外共享); 两者最终合成为一个 dsh_home 视图
if [ -n "${SHARE_DIR}" ]; then
    WORK_HOME="${SHARE_DIR}/dsh_home"
else
    WORK_HOME=""   # 共享目录不可用 → 走旧布局 (DATA_DIR/dsh_home)
fi
DSH_HOME="${DATA_DIR}/dsh_home"

# ── 工作区位置事实源 (只读, 供 28001 面板定位) ──
# 每次 start 把实际生效的 dsh HOME 写入 workspace.active; 面板直接读它,
# 不再依赖环境变量探测链 (手动拉面板/环境不全时会探测错 → 插件列表 500).
# 工作区本身**不可切换**: 目录选择统一走 fnOS 原生「应用设置 → 授权目录」
# (面板经开放 API 读取, 如下载目录), 避免 HOME 树整体搬迁带来的配置漂移.
WS_ACTIVE="${DATA_DIR}/workspace.active"
DSH_LOG="${DATA_DIR}/dsh.log"
DSH_PID="${DATA_DIR}/dsh.pid"
PROXY_LOG="${DATA_DIR}/proxy.log"
PROXY_PID="${DATA_DIR}/proxy.pid"
LOG="${DATA_DIR}/app.log"

# 统一网关 Unix socket (gatewaySocket 声明 app.sock, 放 target 目录)
# /var/apps/<App>/target 是指向 @appcenter/<App> 的软链 (存在); TRIM_APPDEST 本身无 target 子目录
SOCK_PATH="${TRIM_APPDEST_SOCK:-/var/apps/${APP_NAME}/target/app.sock}"
# 确保 socket 目录存在 (target 软链指向 @appcenter, 属主为 dsh 用户可写)
mkdir -p "$(dirname "${SOCK_PATH}")" 2>/dev/null || true
# 用 cmd/main 自身所在目录定位 proxy.py (同一目录), 兼容 fnOS 各种 TRIM_APPDEST
CMD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROXY_SRC="${CMD_DIR}/proxy.py"

# dsh 可执行 + npm 路径
DSH_BIN="$(command -v dsh 2>/dev/null || true)"
NPM=/usr/bin/npm
# fnOS 依赖应用标准接入: /var/apps/<dep>/target 软链保证存在 (无论卷); fallback 到应用卷
[ -x /var/apps/nodejs_v24/target/bin/npm ] && NPM=/var/apps/nodejs_v24/target/bin/npm
[ -x "${APP_VOL}/@appcenter/nodejs_v24/bin/npm" ] && NPM="${APP_VOL}/@appcenter/nodejs_v24/bin/npm"
NODE_BIN=""
for cand in /var/apps/nodejs_v24/target/bin/node "${APP_VOL}/@appcenter/nodejs_v24/bin/node" /usr/bin/node; do
    [ -x "$cand" ] && NODE_BIN="$cand" && break
done
# 离线 dsh 包 (随 fpk 打包在 app/server, 安装后解压在 ${TRIM_APPDEST}/server)
DSH_JS=""
for cand in "${APP_DIR}/target/server/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            "${APP_DIR}/server/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            "${APP_DIR}/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            /var/apps/nodejs_v24/target/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
            "${APP_VOL}/@appcenter/nodejs_v24/lib/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js; do
    [ -f "$cand" ] && DSH_JS="$cand" && break
done

log() { echo "[$(date '+%F %T')] $*" >> "${LOG}"; }

# 数据迁移: 旧布局 (全部在 @appdata/<app>/dsh_home) → 新布局:
#   工作空间/会话 → ${WORK_HOME} (@appshare, 卸载不删、文件管理器可见)
#   凭据类文件   → 留在 ${DSH_HOME} (@appdata, 不对外共享)
# 一次性: 迁移成功后落标记 .migrated-to-share, 之后不再执行 (幂等).
# 安全: 先复制再校验, 成功才移走源文件; 失败保留原样并以旧布局启动 (不清数据).
migrate_dsh_home() {
    # 未启用共享目录 → 保持旧布局, 什么都不做
    [ -z "${WORK_HOME}" ] && return 1
    # 已迁移过 → 直接走新布局
    [ -f "${DSH_HOME}/.migrated-to-share" ] && return 0
    # 源目录不存在 (全新安装) → 建好新布局即可
    if [ ! -d "${DSH_HOME}" ]; then
        mkdir -p "${WORK_HOME}" 2>/dev/null || { log "share: mkdir ${WORK_HOME} 失败, 回退旧布局"; return 1; }
        touch "${DSH_HOME}/.migrated-to-share" 2>/dev/null || true
        return 0
    fi
    # 凭据类: 留在数据区, 不随迁
    local CREDS=".env .credentials.yaml proxy.conf trusted_hosts.conf"
    mkdir -p "${WORK_HOME}" 2>/dev/null || { log "share: mkdir ${WORK_HOME} 失败, 回退旧布局"; return 1; }
    log "share: 迁移 dsh_home → ${WORK_HOME} (凭据保留在 ${DSH_HOME})"
    # 复制所有内容 (包含隐藏文件); cp 失败不立即中断, 交给下面的逐文件校验判定
    cp -a "${DSH_HOME}/." "${WORK_HOME}/" 2>>"${LOG}" || log "share: WARN cp 返回非 0, 交给逐文件校验"

    # 校验 (关键): 逐文件比对大小, 而不是只查顶层目录名.
    # 只查目录名会在"目录建好了但里面没拷全"时误判成功 → 随后 rm -rf 源数据 → 真丢数据.
    # 凭据类不参与校验也不需要迁移 (留在 @appdata), 但要保证目标里没有它们.
    local missing=0 f rel sz_src sz_dst
    while IFS= read -r f; do
        rel="${f#"${DSH_HOME}"/}"
        case " ${CREDS} " in *" ${rel} "*) continue;; esac
        if [ ! -f "${WORK_HOME}/${rel}" ]; then
            missing=1; log "share: 校验缺失 ${rel} (迁移中止, 源数据不动)"
        else
            sz_src="$(stat -c '%s' "${f}" 2>/dev/null || echo -1)"
            sz_dst="$(stat -c '%s' "${WORK_HOME}/${rel}" 2>/dev/null || echo -2)"
            [ "${sz_src}" = "${sz_dst}" ] || { missing=1; log "share: 校验大小不符 ${rel} (${sz_src}≠${sz_dst})"; }
        fi
    done < <(find "${DSH_HOME}" -type f ! -name '.migrated-to-share' 2>/dev/null)

    if [ "${missing}" != "0" ]; then
        # 校验失败: 保留旧布局原样启动, 不清任何源文件 (下次启动重试)
        log "share: 迁移校验失败 → 本次回退旧布局 (源数据完好, 未删除)"
        return 1
    fi

    # 校验通过才清理: 凭据从共享目录剔除 + 源侧移除已迁移项 (避免双份占用)
    local c
    for c in ${CREDS}; do rm -f "${WORK_HOME}/${c}" 2>/dev/null; done
    local item base
    for item in "${DSH_HOME}"/* "${DSH_HOME}"/.[!.]*; do
        [ -e "${item}" ] || continue
        base="$(basename "${item}")"
        case " ${CREDS} " in *" ${base} "*) continue;; esac
        rm -rf "${item}" 2>/dev/null
    done
    touch "${DSH_HOME}/.migrated-to-share" 2>/dev/null || true
    log "share: 迁移完成 (工作空间 → ${WORK_HOME}, 凭据 → ${DSH_HOME})"
    return 0
}

# 寻找 dsh 可执行; 无 bin 链接时用 node 直接运行 dsh 的 bin.js (优先离线包)
find_dsh_bin() {
    local cand
    for cand in "${DSH_BIN}" /var/apps/nodejs_v24/target/bin/dsh "${APP_VOL}/@appcenter/nodejs_v24/bin/dsh" /usr/local/bin/dsh /usr/bin/dsh; do
        if [ -x "${cand}" ]; then
            DSH_BIN="${cand}"
            return 0
        fi
    done
    # 兜底: 用 node 运行离线/全局 dsh 的 bin.js
    if [ -x "${NODE_BIN}" ] && [ -n "${DSH_JS}" ] && [ -f "${DSH_JS}" ]; then
        DSH_BIN="${NODE_BIN}"
        DSH_ARGS="${DSH_JS}"
        return 0
    fi
    return 1
}

# 启动 dsh web (绑 0.0.0.0:DSH_PORT, 经 patch 覆盖 host 绕过 CLI 0.0.0.0 校验)
start_dsh() {
    [ -x "${DSH_BIN}" ] || { log "dsh not found (${DSH_BIN})"; return 1; }
    if [ -f "${DSH_PID}" ] && kill -0 "$(cat "${DSH_PID}")" 2>/dev/null; then
        return 0
    fi
    # 自愈: 若端口 DSH_PORT 已被残留孤儿进程占用, 尝试清理防 EADDRINUSE
    local port_pids
    port_pids="$(fuser "${DSH_PORT}/tcp" 2>/dev/null || true)"
    if [ -n "${port_pids}" ]; then
        log "WARN: port ${DSH_PORT} occupied by [${port_pids}], killing stale process..."
        fuser -k -9 "${DSH_PORT}/tcp" 2>/dev/null || true
        sleep 1
    fi
    # 数据落点切换 (issue #2): 工作空间/会话迁到 @appshare, 凭据留 @appdata.
    # 失败时 HOME_DIR 回退 DSH_HOME → 行为与旧版完全一致 (不清数据、不影响启动).
    local HOME_DIR="${DSH_HOME}"
    if [ -n "${WORK_HOME}" ] && migrate_dsh_home; then
        HOME_DIR="${WORK_HOME}"
        # 凭据在 @appdata: 用软链把它们接进共享 HOME, 使 dsh 仍从同一 HOME 读到
        # .env / proxy.conf / trusted_hosts.conf, 而真实文件不落在用户可见目录.
        local cred
        for cred in .env .credentials.yaml proxy.conf trusted_hosts.conf; do
            if [ -e "${DSH_HOME}/${cred}" ]; then
                [ -e "${HOME_DIR}/${cred}" ] || ln -sf "${DSH_HOME}/${cred}" "${HOME_DIR}/${cred}" 2>/dev/null || true
            elif [ -f "${HOME_DIR}/${cred}" ] && [ ! -L "${HOME_DIR}/${cred}" ]; then
                # 新装机时 dsh 会直接在 HOME 里现生成凭据 (如 .credentials.yaml):
                # 归位数据区再软链回去, 保证凭据始终不落共享目录
                mv "${HOME_DIR}/${cred}" "${DSH_HOME}/${cred}" 2>/dev/null \
                    && ln -sf "${DSH_HOME}/${cred}" "${HOME_DIR}/${cred}" 2>/dev/null || true
            fi
        done
        log "share: 使用共享工作空间 HOME=${HOME_DIR} (凭据软链自 ${DSH_HOME})"
    fi
    # 落盘实际生效的 dsh HOME (面板的工作区定位事实源, 见顶部 WS_ACTIVE 说明)
    printf '%s\n' "${HOME_DIR}" > "${WS_ACTIVE}" 2>/dev/null || true
    # 初始化 HOME (共享工作空间或旧数据区)
    mkdir -p "${HOME_DIR}/profiles/web" "${HOME_DIR}/logs" 2>/dev/null
    # 权限自愈: dsh 强制安全要求 .credentials.yaml / .env 必须是 mode 600 (只属主可读写),
    # 否则抛 credentials-local: is readable beyond its owner (mode 770) 拒不启动.
    # 注意: 真实凭据在 @appdata (上), 共享目录里可能是软链; 两处都收紧权限.
    chmod 600 "${DSH_HOME}/.credentials.yaml"* "${DSH_HOME}/.env" 2>/dev/null || true
    chmod 600 "${HOME_DIR}/.credentials.yaml"* "${HOME_DIR}/.env" 2>/dev/null || true
    # 确保隐藏文件若被 root 误调试创建时属主归还给当前用户 (防 chokidar EACCES)
    if [ "$(id -u)" != "0" ] && [ -f "${HOME_DIR}/.gitconfig" ] && [ ! -r "${HOME_DIR}/.gitconfig" ]; then
        chmod 644 "${HOME_DIR}/.gitconfig" 2>/dev/null || true
    fi
    # dsh 用 os.homedir() 作为工作目录, 默认 /home/dsh 不存在会导致 ENOENT.
    # 确保存在且可写, 并把 HOME 指向共享工作空间 (卸载不删、文件管理器可见).
    if [ "${HOME:-}" != "${HOME_DIR}" ]; then
        export HOME="${HOME_DIR}"
    fi
    mkdir -p "${HOME}" 2>/dev/null
    if [ -n "${TRIM_PKGVAR:-}" ]; then
        mkdir -p "/home/${APP_NAME}" 2>/dev/null || true
    fi
    # 网络代理: 默认不走代理. 仅当用户在 ${DSH_HOME}/proxy.conf 显式配置了 PROXY 才走代理.
    # (proxy.conf 始终在 @appdata 数据区, 不随工作空间迁移 — 属凭据类配置)
    # proxy.conf 内容示例:  PROXY=http://127.0.0.1:7890   (HTTP_PROXY/HTTPS_PROXY 都指向它)
    if [ -z "${HTTP_PROXY:-}" ] && [ -z "${http_proxy:-}" ]; then
        if [ -f "${DSH_HOME}/proxy.conf" ]; then
            CFG_PROXY="$(grep -E '^PROXY=' "${DSH_HOME}/proxy.conf" | head -1 | cut -d= -f2-)"
            if [ -n "${CFG_PROXY}" ]; then
                export HTTP_PROXY="${CFG_PROXY}" HTTPS_PROXY="${CFG_PROXY}" http_proxy="${CFG_PROXY}" https_proxy="${CFG_PROXY}" ALL_PROXY="${CFG_PROXY}" all_proxy="${CFG_PROXY}"
                git config --global http.proxy "${CFG_PROXY}" 2>/dev/null
                git config --global https.proxy "${CFG_PROXY}" 2>/dev/null
                log "network proxy from proxy.conf: ${CFG_PROXY}"
            else
                log "proxy.conf present but no PROXY= line; default no-proxy"
            fi
        fi
    fi
    # 工作区注册表路径修复: 老布局迁移到共享区后, storages/workspace.json 里的工作区
    # 绝对路径仍指向旧 HOME (@appdata/dsh/dsh_home/...), 这些目录已不存在 → 会话/目录
    # 选择器落在死路径上。幂等: 仅当文件包含旧前缀时重写为当前 HOME_DIR 前缀;
    # 工作区在 HOME 之外的路径 (如用户网盘目录) 原样保留.
    if [ "${HOME_DIR}" != "${DSH_HOME}" ] && [ -f "${HOME_DIR}/storages/workspace.json" ] \
        && grep -q "${DSH_HOME}/" "${HOME_DIR}/storages/workspace.json" 2>/dev/null \
        && command -v python3 >/dev/null 2>&1; then
        WS_REG="${HOME_DIR}/storages/workspace.json" WS_OLD="${DSH_HOME}/" WS_NEW="${HOME_DIR}/" \
            python3 - <<'FIXWS'
import json, os
reg, old, new = os.environ["WS_REG"], os.environ["WS_OLD"], os.environ["WS_NEW"]
d = json.load(open(reg, encoding="utf-8"))
n = 0
for w in ((d.get("tables") or {}).get("workspaces") or {}).values():
    p = w.get("path") or ""
    if p.startswith(old):
        w["path"] = new + p[len(old):]
        n += 1
if n:
    json.dump(d, open(reg, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
print(f"rewritten {n} workspace path(s)")
FIXWS
        log "workspace-registry: 已将注册表内 ${DSH_HOME}/ 前缀的工作区路径重写为 ${HOME_DIR}/"
    fi
    # 写入 cordis.patch.yml: 覆盖 webserver 绑 0.0.0.0 (允许局域网/Tailscale 直连)
    # dsh CLI --host 0.0.0.0 会被 web-startup 插件拒绝; patch 层优先级更高, 绕过校验
    #
    # ⚠️ 上游 0.1.7+ 起 UI 的设置也写进本文件 (不再有 settings.yaml), 而本函数
    # 在每次 start 都会执行。若无条件整文件覆盖, 用户在 UI 里的任何变更都会在
    # 下次重启时丢失 (issue #5)。因此这里改为**幂等 upsert**:
    #   - 只增改 id: webserver 的 host/port 两行, 其余内容 (用户/其他插件的配置) 原样保留
    #   - YAML 键按 id 对齐 (首行裸 `- ` 缩进 0), 与上游生成格式一致, 避免结构错位
    #   - python3 不可用时回退为原整文件写入 (宁可丢失也不让服务起不来)
    # 注意必须写在 dsh 实际读取的 HOME (HOME_DIR, 共享布局下是 @appshare) 里;
    # 写到 DSH_HOME (数据区) 会被 dsh 视为不存在而在共享区重建空模板, 0.0.0.0 绑定随之失效
    CORDIS_PATCH="${HOME_DIR}/profiles/web/cordis.patch.yml"
    if [ -f "${CORDIS_PATCH}" ] && grep -qE '^[[:space:]]*-[[:space:]]*id:[[:space:]]*["'"'"']?webserver' "${CORDIS_PATCH}" 2>/dev/null \
        && command -v python3 >/dev/null 2>&1; then
        CORDIS_PATCH="${CORDIS_PATCH}" DSH_PORT="${DSH_PORT}" /usr/bin/env python3 - <<'PATCHYML'
import os, re
p = os.environ["CORDIS_PATCH"]
port = os.environ["DSH_PORT"]
lines = open(p, encoding="utf-8").read().splitlines(keepends=True)
# 定位 `- id: webserver` 块 (缩进 0 的列表项), 到下一个同级 `- ` 为止
start = end = None
for i, ln in enumerate(lines):
    if re.match(r'^[ \t]*-[ \t]*id:[ \t]*["\']?webserver["\']?[ \t]*$', ln.rstrip("\r\n")):
        start = i
        j = i + 1
        while j < len(lines) and not re.match(r'^[ \t]*-[ \t]', lines[j]):
            j += 1
        end = j
        break
if start is None:
    raise SystemExit(0)  # 调用方回退整文件写入
block = lines[start:end]
def indent_of(line):
    return re.match(r'^[ \t]*', line).group(0)
cfg = next((k for k, ln in enumerate(block)
            if re.match(r'^[ \t]*config:[ \t]*$', ln)), None)
if cfg is None:                       # 该块没有 config: → 补一行
    block.append(indent_of(block[0]) + "  config:\n")
    cfg = len(block) - 1
v_ind = indent_of(block[cfg]) + "  "
def upsert(key, value):
    # value 原样写入: host 是 YAML 字符串 (自带引号), port 必须是裸数字 —
    # dsh 0.2.0 schema 校验 $.port expected number, 写成 "28000" 会让
    # webserver 插件激活失败 → 整个 web 起不来
    for k in range(cfg + 1, len(block)):
        if re.match(r'^[ \t]*' + key + r':[ \t]', block[k]):
            block[k] = "{} {}: {}\n".format(v_ind, key, value)
            return
    insert_at = len(block)
    for k in range(cfg + 1, len(block)):
        if re.match(r'^[ \t]*[\w-]+:[ \t]', block[k]):
            insert_at = k + 1
    if insert_at == len(block) and block and not block[-1].endswith("\n"):
        block[-1] += "\n"
    block.insert(insert_at, "{} {}: {}\n".format(v_ind, key, value))
upsert("host", '"0.0.0.0"')
upsert("port", port)
# 归一化 webserver 块缩进 (2/4 空格), 保持文件整洁且与上游生成格式一致
for k, ln in enumerate(block):
    m = re.match(r'^([ \t]*)([\w-]+):(.*)$', ln.rstrip("\r\n"))
    if not m:
        continue
    if k == 0:
        block[k] = "- {}:{}\n".format(m.group(2), m.group(3))
    elif m.group(2) == "config":
        block[k] = "  config:{}\n".format(m.group(3))
    else:
        block[k] = "    {}:{}\n".format(m.group(2), m.group(3))
lines[start:end] = block
open(p, "w", encoding="utf-8").write("".join(lines))
PATCHYML
        if [ $? -ne 0 ]; then
            log "cordis.patch.yml: webserver 块 upsert 失败, 回退整文件写入"
            cat > "${CORDIS_PATCH}" <<PATCHEOF
# 覆盖 webserver 配置: 绑定 0.0.0.0 允许局域网/Tailscale 直接访问 (绕过 CLI 安全校验)
- id: webserver
  config:
    host: "0.0.0.0"
    port: ${DSH_PORT}
PATCHEOF
        else
            log "cordis.patch.yml: webserver host/port 已 upsert (保留 UI 既有配置)"
        fi
    else
        # 首次启动 (文件不存在) 或文件里没有 webserver 条目: 整文件写入基础内容
        cat > "${CORDIS_PATCH}" <<PATCHEOF
# 覆盖 webserver 配置: 绑定 0.0.0.0 允许局域网/Tailscale 直接访问 (绕过 CLI 安全校验)
- id: webserver
  config:
    host: "0.0.0.0"
    port: ${DSH_PORT}
PATCHEOF
    fi
    chmod 644 "${CORDIS_PATCH}" 2>/dev/null
    # 构建 /api browser-trust fence 的 trusted-host 列表:
    # dsh 只信任回环地址或 --trusted-host 声明的 authority, 否则局域网访问 API 全 403.
    # 把本机所有非回环 IPv4 (局域网/Tailscale 等) 都加入信任, 允许从这些地址直连访问 API.
    # 注意: dsh 的 --trusted-host <authority...> 是 variadic (一个 flag 带多个值),
    # 重复的 --trusted-host flag 会被 commander 后者覆盖, 只保留最后一个. 所以必须用单个
    # --trusted-host 拼所有值 (空格分隔).
    TRUSTED_HOST_VALUES=""
    LAN_IPS="$(ip -4 addr show 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}' | grep -v '^127\\.' || true)"
    for ip in ${LAN_IPS}; do
        TRUSTED_HOST_VALUES="${TRUSTED_HOST_VALUES} ${ip}"
    done
    # 内置默认 trusted-host: fnos.net / 5ddd.com (飞牛两条 FN Connect 域名后缀, issue #7)
    # + 本机非回环 IP. 两者都后缀匹配生效, 无需用户手动填。
    TRUSTED_HOST_VALUES="${TRUSTED_HOST_VALUES} fnos.net 5ddd.com"
    # 读取用户配置的 FN Connect 域名 (FN ID), 每行一个, 追加.
    # 配置在 ${DSH_HOME}/trusted_hosts.conf, 与 proxy.conf 机制一致; # 开头为注释.
    # 自动清理: 去掉 http(s):// 前缀与结尾 /, 否则非法条目会让整个 trustedHosts 加载失败 → 全 403.
    if [ -f "${DSH_HOME}/trusted_hosts.conf" ]; then
        while IFS= read -r raw_host; do
            host="$(printf '%s' "${raw_host}" | sed -e 's#^https\?://##' -e 's#/$##' -e 's/[[:space:]]//g')"
            [ -z "${host}" ] && continue
            case "${host}" in \#*) continue;; esac
            TRUSTED_HOST_VALUES="${TRUSTED_HOST_VALUES} ${host}"
        done < "${DSH_HOME}/trusted_hosts.conf"
    fi
    TRUSTED_HOST_VALUES="$(printf '%s' "${TRUSTED_HOST_VALUES}" | tr -s ' ' | sed 's/^ *//;s/ *$//')"
    # 兜底: 若未探测到, 至少信任回环
    [ -z "${TRUSTED_HOST_VALUES}" ] && TRUSTED_HOST_VALUES="127.0.0.1"
    TRUSTED_HOST_ARGS="--trusted-host ${TRUSTED_HOST_VALUES}"
    # 放宽 dsh 特权 API (/api/settings.* 等) 的回环钉扎:
    # 上游对 PRIVILEGED_METHODS 硬编码只信回环, 局域网直连 API 全 403.
    # 幂等 patch dsh-client-connection, 让特权 API 也用 --trusted-host 列表.
    # 多路径定位 CC_LIB (DSH_JS 可能因软链/部署差异为空, 直接探测 node_modules 位置)
    CC_LIB=""
    for cand in \
        "$(dirname "$(dirname "${DSH_JS}")")/dsh-client-connection/lib/index.js" \
        "${APP_DIR}/target/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "${APP_DIR}/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "${APP_VOL}/@appcenter/deepseek-harness/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "${APP_VOL}/@appcenter/dsh/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "/vol4/@appcenter/deepseek-harness/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "/vol4/@appcenter/dsh/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js"; do
        [ -f "$cand" ] && CC_LIB="$cand" && break
    done
    if [ -n "${CC_LIB}" ]; then
        # patch 结果落 app.log (远程可诊断, 否则只打 stdout 装完即丢)
        patch_out=$(/usr/bin/python3 - "${CC_LIB}" <<'PATCHPY'
import sys
p = sys.argv[1]
s = open(p, encoding="utf-8").read()
changed = False
old1 = 'PRIVILEGED_METHODS.has(method) && !isTrustedApiRequest(request, []))'
new1 = 'PRIVILEGED_METHODS.has(method) && !isTrustedApiRequest(request, trustedHosts))'
if old1 in s and new1 not in s:
    s = s.replace(old1, new1); changed = True
old2 = 'if (interceptor.options.authority == "loopback" && !isTrustedApiRequest(request, []))'
old2b = 'if (interceptor.options.authority === "loopback" && !isTrustedApiRequest(request, []))'
new2 = 'if (interceptor.options.authority === "loopback" && !isTrustedApiRequest(request, this.trustedHosts))'
if old2b in s and new2 not in s:
    s = s.replace(old2b, new2); changed = True
elif old2 in s and new2 not in s:
    s = s.replace(old2, new2); changed = True
old3 = 'const trustedHosts = options.authority === "loopback" ? [] : this.trustedHosts;'
new3 = 'const trustedHosts = this.trustedHosts;'
if old3 in s and new3 not in s:
    s = s.replace(old3, new3); changed = True
# 浏览器鉴权放行: dsh web 启动铸一次性 launch token (打印在日志), 浏览器凭
# GET /?token= 换 30 天 authority 绑定 cookie; 裸开 / 无 cookie 即 401
# "authentication required; reopen the URL printed by dsh web" — fpk 桌面入口
# 是静态 URL, 每次重启 token 都变, 用户没法感知. 放行依据: Host/Origin 信任
# 围栏 (api-request-trust, 403) 在鉴权 (401) 之前执行, 能走到鉴权的请求必然
# 已属于 loopback / --trusted-host 白名单 — 与上面特权 API 放行是同一信任决策.
old4 = "isAuthenticated(request) {\n\t\tconst authority = requestAuthority(request.headers);"
new4 = "isAuthenticated(request) {\n\t\treturn true; /* fnos-fpk: browser token auth off, host/origin trust fence is the gate */\n\t\tconst authority = requestAuthority(request.headers);"
if old4 in s and new4 not in s:
    s = s.replace(old4, new4); changed = True
if changed:
    open(p, "w", encoding="utf-8").write(s)
    print("privileged-fence patched" if new1 in s or new2 in s else "privileged-fence already patched", end="")
    print(" + browser-auth bypassed" if new4 in s else " + browser-auth patch FAILED (pattern mismatch)")
elif "isTrustedApiRequest(request, this.trustedHosts)" in s or "isTrustedApiRequest(request, trustedHosts)" in s:
    print("privileged-fence native in upstream (>=0.1.2), no patch needed")
else:
    print("privileged-fence already patched")
if new4 in s:
    print("browser-auth: token auth off (trust fence only); launch-token URLs still redirect to clean /")
elif old4 in s:
    print("WARNING: browser-auth patch did not apply — desktop entry will 401 until token URL visited")
PATCHPY
2>&1)
        # python3 不可用/失败时用 node 兜底 (dsh 硬依赖 nodejs_v24, 必存在);
        # 部分 fnOS 环境 /usr/bin/python3 缺失曾致补丁静默失败 → 桌面 401
        if [ -z "$patch_out" ] || echo "$patch_out" | grep -qi "error\|traceback\|not found"; then
            log "privileged-fence patch: python3 不可用或失败, 尝试 node 兜底"
            patch_out=$("${NODE_BIN:-node}" -e '
const fs = require("fs");
const p = process.argv[1];
let s = fs.readFileSync(p, "utf8"), changed = false;
const reps = [
  ["PRIVILEGED_METHODS.has(method) && !isTrustedApiRequest(request, []))",
   "PRIVILEGED_METHODS.has(method) && !isTrustedApiRequest(request, trustedHosts))"],
  ["if (interceptor.options.authority === \"loopback\" && !isTrustedApiRequest(request, []))",
   "if (interceptor.options.authority === \"loopback\" && !isTrustedApiRequest(request, this.trustedHosts))"],
  ["const trustedHosts = options.authority === \"loopback\" ? [] : this.trustedHosts;",
   "const trustedHosts = this.trustedHosts;"],
  ["isAuthenticated(request) {\n\t\tconst authority = requestAuthority(request.headers);",
   "isAuthenticated(request) {\n\t\treturn true; /* fnos-fpk: browser token auth off, host/origin trust fence is the gate */\n\t\tconst authority = requestAuthority(request.headers);"]
];
for (const [o, n] of reps) { if (s.includes(o) && !s.includes(n)) { s = s.split(o).join(n); changed = true; } }
if (changed) { fs.writeFileSync(p, s); console.log("node fallback: patched"); }
else if (reps.some(([,n]) => s.includes(n)) || s.includes("fnos-fpk: browser token auth off")) console.log("already patched");
else console.log("WARNING: no pattern matched (upstream code changed?)");
' "${CC_LIB}" 2>&1)
        fi
        log "privileged-fence patch: ${patch_out:-no output}"
    else
        log "privileged-fence patch: SKIP (dsh-client-connection/lib/index.js 未找到, CC_LIB 定位失败 — 检查安装布局)"
    fi

    # 修复图片/附件持久化向上同步触发 @appshare EACCES 权限错误 (issue #9):
    # dsh-attachment-local 的 ensureDurableHome 默认把 boundary 设为 parse(home).root,
    # 会从 @appshare/dsh/dsh_home 一路向上 fs.open 父目录进行 fsync 同步.
    # fnOS 的 @appshare 是系统共享目录, 普通 dsh 账号无权读取/open /volX/@appshare,
    # 导致上传图片时抛出 EACCES 被包装成 session/agent-busy 假死拒绝.
    # 幂等补丁将 boundary 限制在 home 自身, 避免越界同步宿主系统目录.
    ATTACH_LIB=""
    for cand in \
        "$(dirname "$(dirname "${DSH_JS}")")/dsh-attachment-local/lib/index.js" \
        "${APP_DIR}/target/server/node_modules/@deepseek-ai/dsh-attachment-local/lib/index.js" \
        "${APP_DIR}/server/node_modules/@deepseek-ai/dsh-attachment-local/lib/index.js" \
        "${APP_VOL}/@appcenter/deepseek-harness/server/node_modules/@deepseek-ai/dsh-attachment-local/lib/index.js" \
        "${APP_VOL}/@appcenter/dsh/server/node_modules/@deepseek-ai/dsh-attachment-local/lib/index.js" \
        "/vol4/@appcenter/deepseek-harness/server/node_modules/@deepseek-ai/dsh-attachment-local/lib/index.js" \
        "/vol4/@appcenter/dsh/server/node_modules/@deepseek-ai/dsh-attachment-local/lib/index.js"; do
        [ -f "$cand" ] && ATTACH_LIB="$cand" && break
    done
    if [ -n "${ATTACH_LIB}" ]; then
        attach_patch_out=$(/usr/bin/python3 - "${ATTACH_LIB}" <<'ATTACHPY'
import sys
p = sys.argv[1]
s = open(p, encoding="utf-8").read()
old = "await ensureDurableDirectory(home, parse(home).root);"
new = "await ensureDurableDirectory(home, home); /* dsh-fnos: do not sync ancestor outside dsh home (issue #9) */"
if new in s:
    print("attachment-durability patch: already patched")
elif old in s:
    s = s.replace(old, new)
    open(p, "w", encoding="utf-8").write(s)
    print("attachment-durability patch: patched")
else:
    print("attachment-durability patch: SKIP (upstream changed?)")
ATTACHPY
2>&1)
        if [ -z "$attach_patch_out" ] || echo "$attach_patch_out" | grep -qi "error\|traceback\|not found"; then
            attach_patch_out=$("${NODE_BIN:-node}" -e '
const fs = require("fs");
const p = process.argv[1];
let s = fs.readFileSync(p, "utf8");
const old = "await ensureDurableDirectory(home, parse(home).root);";
const rep = "await ensureDurableDirectory(home, home); /* dsh-fnos: do not sync ancestor outside dsh home (issue #9) */";
if (s.includes(rep)) { process.stdout.write("attachment-durability patch: already patched (node)"); }
else if (s.includes(old)) {
  s = s.replace(old, rep);
  fs.writeFileSync(p, s);
  process.stdout.write("attachment-durability patch: patched (node)");
} else {
  process.stdout.write("attachment-durability patch: SKIP (upstream changed?) (node)");
}
' "${ATTACH_LIB}" 2>&1)
        fi
        log "${attach_patch_out}"
    else
        log "attachment-durability patch: SKIP (dsh-attachment-local/lib/index.js 未找到)"
    fi
    # 启动 dsh web: 不带 --host (让 patch 的 0.0.0.0 生效), 显式传 --port + trusted-host
    # DSH_ARGS 非空时 = 用 node <bin.js> 运行 (无 bin 链接的兜底)
    # dsh 自托管 node: 把 nodejs_v24 bin 目录加入 PATH, 供 dsh 进程及 agent 调用 node/npm
    if [ -n "${NODE_BIN}" ]; then
        NODE_BIN_DIR="$(dirname "${NODE_BIN}" 2>/dev/null)"
        case ":${PATH}:" in
            *":${NODE_BIN_DIR}:"*) : ;;
            *) export PATH="${NODE_BIN_DIR}:${PATH}" ;;
        esac
        # corepack shims (pnpm/yarn) 加入 PATH: nodejs_v24 的 corepack 提供 pnpm 命令,
        # 供 dsh agent 环境直接调用. shims 位于 <prefix>/lib/node_modules/corepack/shims
        for cand in \
            "$(dirname "${NODE_BIN_DIR}")/lib/node_modules/corepack/shims" \
            "${NODE_BIN_DIR}/lib/node_modules/corepack/shims"; do
            if [ -d "${cand}" ]; then
                case ":${PATH}:" in
                    *":${cand}:"*) : ;;
                    *) export PATH="${cand}:${PATH}" ;;
                esac
                # 固定 pnpm 版本 + 缓存目录放 HOME (避免每次重下, 也避免占用系统盘)
                export COREPACK_HOME="${HOME_DIR}/.corepack" 2>/dev/null || true
                export COREPACK_DEFAULT_TO_LATEST=0
                log "corepack shims: ${cand} (pnpm available, COREPACK_HOME=${HOME_DIR}/.corepack)"
                break
            fi
        done
        # npm 全局 prefix 指向 HOME: 避免读到 /home/<user>/.npmrc 的 prefix 导致
        # "config prefix cannot be changed from project config" 且全局安装落系统盘.
        mkdir -p "${HOME_DIR}/.npm-global" 2>/dev/null || true
        export npm_config_prefix="${HOME_DIR}/.npm-global"
        export npm_config_cache="${HOME_DIR}/.npm" 2>/dev/null || true
        log "npm prefix -> ${HOME_DIR}/.npm-global (HOME)"
        # bun (fnOS 依赖应用 bunjs): 把 bin 加入 PATH, 供 dsh agent 环境调用
        for cand in /var/apps/bunjs/target/bin "${APP_VOL:-}/@appcenter/bunjs/bin"; do
            if [ -x "${cand}/bun" ]; then
                case ":${PATH}:" in
                    *":${cand}:"*) : ;;
                    *) export PATH="${cand}:${PATH}" ;;
                esac
                log "bun available via: ${cand}/bun"
                break
            fi
        done
        log "dsh self-hosting node via: ${NODE_BIN}"
    fi
    # issue #3 备注 (2026-10-01 真机核查, 0.2.0-rc.2): 曾在此尝试放宽
    # dsh-host-webserver 的「插件 prefix 路由」信任门, 但该文件的 trust 判定
    # 并不存在 (它只做路由分发, 非回环拒绝发生在 dsh-client-connection 的
    # requestRejection → 403, 空响应体 400 来自 webserver 对 handler 异常的
    # 兜底 catch). 无可放宽的门, 补丁已移除; #3 需拿到可复现的插件路由现场
    # (哪个插件、哪个 URL、回环 vs 非回环的状态码) 再定位.
    HOME="${HOME_DIR}" DSH_HOME="${HOME_DIR}" nohup "${DSH_BIN}" ${DSH_ARGS:-} web --port "${DSH_PORT}" ${TRUSTED_HOST_ARGS} \
        >> "${DSH_LOG}" 2>&1 &
    echo $! > "${DSH_PID}"
    log "dsh web started (pid $(cat "${DSH_PID}")) :0.0.0.0:${DSH_PORT} (patch: host 0.0.0.0) trusted-host:${TRUSTED_HOST_VALUES}"
    sleep 3
    # 落盘带 token 的访问 URL (参考/应急): 启动日志形如
    #   dsh web: http://127.0.0.1:28000/?token=… (LAN: http://192.168.x.x:28000/?token=…)
    # 浏览器鉴权已被 fpk patch 关闭(信任围栏兜底), 平时无需此文件; dsh 重启后 token 会变,
    # 这里始终抓最后一次启动的输出.
    ( sleep 6
      URL_LINE="$(grep -o 'dsh web: .*' "${DSH_LOG}" 2>/dev/null | tail -1 || true)"
      if [ -n "${URL_LINE}" ]; then
          printf '%s\n' "${URL_LINE#dsh web: }" > "${DATA_DIR}/dsh-web-url.txt"
          log "web url (token) -> ${DATA_DIR}/dsh-web-url.txt"
      else
          log "no launch-token URL in log (browser-auth patch active, expected on later runs)"
      fi
    ) &
}

# 启动统一网关代理 (Unix socket → 127.0.0.1:DSH_PORT)
start_proxy() {
    [ -f "${PROXY_SRC}" ] || { log "proxy.py not found (${PROXY_SRC})"; return 0; }
    if [ -f "${PROXY_PID}" ] && kill -0 "$(cat "${PROXY_PID}")" 2>/dev/null; then
        return 0
    fi
    PY="$(command -v python3 || echo /usr/bin/python3)"
    DSH_PORT="${DSH_PORT}" SOCK_PATH="${SOCK_PATH}" \
      nohup "${PY}" "${PROXY_SRC}" >> "${PROXY_LOG}" 2>&1 &
    echo $! > "${PROXY_PID}"
    log "proxy started (pid $(cat "${PROXY_PID}")) ${SOCK_PATH} -> 127.0.0.1:${DSH_PORT}"
    sleep 1
}

# 启动独立管理面板 (dashboard.js, 端口 28001): 状态/日志/插件管理/版本检查
DASH_LOG="${DATA_DIR}/dashboard.log"
DASH_PID="${DATA_DIR}/dashboard.pid"
DASH_PORT="${DASH_PORT:-28001}"
start_dashboard() {
    [ -f "${CMD_DIR}/dashboard.js" ] || { log "dashboard: dashboard.js not found, skip"; return 0; }
    if [ -f "${DASH_PID}" ] && kill -0 "$(cat "${DASH_PID}")" 2>/dev/null; then
        return 0
    fi
    DASH_NODE="${NODE_BIN}"
    [ -x "${DASH_NODE}" ] || DASH_NODE="$(command -v node)"
    [ -x "${DASH_NODE}" ] || { log "dashboard: no node, skip"; return 0; }
    DASH_PORT="${DASH_PORT}" DSH_PORT="${DSH_PORT}" DATA_DIR="${DATA_DIR}" DSH_HOME="${DSH_HOME}" \
      APP_DIR="${APP_DIR}" CMD_MAIN="${CMD_DIR}/main" NODE_BIN="${NODE_BIN}" \
      MANIFEST="$(dirname "${CMD_DIR}")/manifest" \
      nohup "${DASH_NODE}" "${CMD_DIR}/dashboard.js" >> "${DASH_LOG}" 2>&1 &
    echo $! > "${DASH_PID}"
    log "dashboard started (pid $(cat "${DASH_PID}")) :0.0.0.0:${DASH_PORT}"
}

start() {
    # 数据区 (凭据/日志/pid) + 工作空间 (若已启用共享目录, 空占位, start_dsh 内迁移)
    mkdir -p "${DATA_DIR}" "${DSH_HOME}"
    [ -n "${WORK_HOME}" ] && mkdir -p "${WORK_HOME}" 2>/dev/null || true
    # 防死锁: 若历史 pid 文件因权限或所有权不可写, 尝试清理
    for pf in "${DSH_PID}" "${PROXY_PID}" "${DASH_PID}"; do
        [ -e "${pf}" ] && [ ! -w "${pf}" ] && rm -f "${pf}" 2>/dev/null || true
    done
    find_dsh_bin
    start_dsh
    start_proxy
    start_dashboard
    # 健康检查
    sleep 2
    if [ -f "${DSH_PID}" ] && kill -0 "$(cat "${DSH_PID}")" 2>/dev/null; then
        log "dsh health OK"
        return 0
    else
        log "dsh failed to start (check ${DSH_LOG})"
        return 1
    fi
}

stop() {
    # 停 proxy 再停 dsh (dashboard 保留: restart 场景下面板自身不被打断)
    if [ -f "${PROXY_PID}" ]; then
        kill "$(cat "${PROXY_PID}")" 2>/dev/null
        rm -f "${PROXY_PID}"
        log "proxy stopped"
    fi
    pkill -u "$(id -u)" -f "${PROXY_SRC}" 2>/dev/null || true
    if [ -f "${DSH_PID}" ]; then
        kill "$(cat "${DSH_PID}")" 2>/dev/null
        rm -f "${DSH_PID}"
        log "dsh web stopped"
    fi
    # 兜底确保释放 28000 端口
    fuser -k "${DSH_PORT}/tcp" 2>/dev/null || true
    return 0
}

status() {
    if [ -f "${DSH_PID}" ] && kill -0 "$(cat "${DSH_PID}")" 2>/dev/null; then
        echo "dsh web: running (pid $(cat "${DSH_PID}"))"
        return 0
    else
        echo "dsh web: stopped"
        return 1
    fi
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    *) echo "usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
