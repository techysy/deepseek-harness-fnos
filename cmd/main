#!/bin/bash
# cmd/main — DeepSeek Harness (dsh) fnOS 应用生命周期脚本
# fnOS 生命周期: install 由 install_callback 处理; 本脚本处理 start/stop/status/restart
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-dsh}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录: 优先 TRIM_PKGVAR (fnOS 注入). 兜底: 从 fnOS home 软链 (/volX/@apphome/<app>) 推导卷,
# 或从 APP_DIR 推导; 不写死具体卷. (某些 fnOS 部署 APP_DIR=/var/apps/<app> 且无 TRIM_PKGVAR)
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -z "${APP_VOL}" ]; then
        APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi

# 端口: dsh web 绑 0.0.0.0 (经 cordis.patch.yml 覆盖 webserver host, 绕过 CLI 安全校验)
# 局域网/Tailscale 可直接访问 NAS_IP:28000; 同时 proxy.py 经统一网关 /app/dsh 暴露
DSH_PORT="${TRIM_SERVICE_PORT:-28000}"
DSH_HOME="${DATA_DIR}/dsh_home"
DSH_LOG="${DATA_DIR}/dsh.log"
DSH_PID="${DATA_DIR}/dsh.pid"
PROXY_LOG="${DATA_DIR}/proxy.log"
PROXY_PID="${DATA_DIR}/proxy.pid"
LOG="${DATA_DIR}/app.log"

# 统一网关 Unix socket (gatewaySocket 声明 app.sock, 放 target 目录)
# /var/apps/<App>/target 是指向 @appcenter/<App> 的软链 (存在); TRIM_APPDEST 本身无 target 子目录
SOCK_PATH="${TRIM_APPDEST_SOCK:-/var/apps/${APP_NAME}/target/app.sock}"
# 确保 socket 目录存在 (target 软链指向 @appcenter, 属主为 dsh 用户可写)
mkdir -p "$(dirname "${SOCK_PATH}")" 2>/dev/null || true
# 用 cmd/main 自身所在目录定位 proxy.py (同一目录), 兼容 fnOS 各种 TRIM_APPDEST
CMD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROXY_SRC="${CMD_DIR}/proxy.py"

# dsh 可执行 + npm 路径
DSH_BIN="$(command -v dsh 2>/dev/null || true)"
NPM=/usr/bin/npm
# fnOS 依赖应用标准接入: /var/apps/<dep>/target 软链保证存在 (无论卷); fallback 到应用卷
[ -x /var/apps/nodejs_v24/target/bin/npm ] && NPM=/var/apps/nodejs_v24/target/bin/npm
[ -x "${APP_VOL}/@appcenter/nodejs_v24/bin/npm" ] && NPM="${APP_VOL}/@appcenter/nodejs_v24/bin/npm"
NODE_BIN=""
for cand in /var/apps/nodejs_v24/target/bin/node "${APP_VOL}/@appcenter/nodejs_v24/bin/node" /usr/bin/node; do
    [ -x "$cand" ] && NODE_BIN="$cand" && break
done
# 离线 dsh 包 (随 fpk 打包在 app/server, 安装后解压在 ${TRIM_APPDEST}/server)
DSH_JS=""
for cand in "${APP_DIR}/target/server/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            "${APP_DIR}/server/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            "${APP_DIR}/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            /var/apps/nodejs_v24/target/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
            "${APP_VOL}/@appcenter/nodejs_v24/lib/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js; do
    [ -f "$cand" ] && DSH_JS="$cand" && break
done

log() { echo "[$(date '+%F %T')] $*" >> "${LOG}"; }

# 寻找 dsh 可执行; 无 bin 链接时用 node 直接运行 dsh 的 bin.js (优先离线包)
find_dsh_bin() {
    local cand
    for cand in "${DSH_BIN}" /var/apps/nodejs_v24/target/bin/dsh "${APP_VOL}/@appcenter/nodejs_v24/bin/dsh" /usr/local/bin/dsh /usr/bin/dsh; do
        if [ -x "${cand}" ]; then
            DSH_BIN="${cand}"
            return 0
        fi
    done
    # 兜底: 用 node 运行离线/全局 dsh 的 bin.js
    if [ -x "${NODE_BIN}" ] && [ -n "${DSH_JS}" ] && [ -f "${DSH_JS}" ]; then
        DSH_BIN="${NODE_BIN}"
        DSH_ARGS="${DSH_JS}"
        return 0
    fi
    return 1
}

# 启动 dsh web (绑 0.0.0.0:DSH_PORT, 经 patch 覆盖 host 绕过 CLI 0.0.0.0 校验)
start_dsh() {
    [ -x "${DSH_BIN}" ] || { log "dsh not found (${DSH_BIN})"; return 1; }
    if [ -f "${DSH_PID}" ] && kill -0 "$(cat "${DSH_PID}")" 2>/dev/null; then
        return 0
    fi
    # 初始化 DSH_HOME
    mkdir -p "${DSH_HOME}/profiles/web" "${DSH_HOME}/logs" 2>/dev/null
    # dsh 用 os.homedir() 作为工作目录, 默认 /home/dsh 不存在会导致 ENOENT.
    # 确保存在且可写, 并把 HOME 指向 DSH_HOME (数据区, 可持久).
    if [ "${HOME:-}" != "${DSH_HOME}" ]; then
        export HOME="${DSH_HOME}"
    fi
    mkdir -p "${HOME}" 2>/dev/null
    if [ -n "${TRIM_PKGVAR:-}" ]; then
        mkdir -p "/home/${APP_NAME}" 2>/dev/null || true
    fi
    # 网络代理: 默认不走代理. 仅当用户在 ${DSH_HOME}/proxy.conf 显式配置了 PROXY 才走代理.
    # proxy.conf 内容示例:  PROXY=http://127.0.0.1:7890   (HTTP_PROXY/HTTPS_PROXY 都指向它)
    if [ -z "${HTTP_PROXY:-}" ] && [ -z "${http_proxy:-}" ]; then
        if [ -f "${DSH_HOME}/proxy.conf" ]; then
            CFG_PROXY="$(grep -E '^PROXY=' "${DSH_HOME}/proxy.conf" | head -1 | cut -d= -f2-)"
            if [ -n "${CFG_PROXY}" ]; then
                export HTTP_PROXY="${CFG_PROXY}" HTTPS_PROXY="${CFG_PROXY}" http_proxy="${CFG_PROXY}" https_proxy="${CFG_PROXY}" ALL_PROXY="${CFG_PROXY}" all_proxy="${CFG_PROXY}"
                git config --global http.proxy "${CFG_PROXY}" 2>/dev/null
                git config --global https.proxy "${CFG_PROXY}" 2>/dev/null
                log "network proxy from proxy.conf: ${CFG_PROXY}"
            else
                log "proxy.conf present but no PROXY= line; default no-proxy"
            fi
        fi
    fi
    # 写入 cordis.patch.yml: 覆盖 webserver 绑 0.0.0.0 (允许局域网/Tailscale 直连)
    # dsh CLI --host 0.0.0.0 会被 web-startup 插件拒绝; patch 层优先级更高, 绕过校验
    cat > "${DSH_HOME}/profiles/web/cordis.patch.yml" <<PATCHEOF
# 覆盖 webserver 配置: 绑定 0.0.0.0 允许局域网/Tailscale 直接访问 (绕过 CLI 安全校验)
- id: webserver
  config:
    host: "0.0.0.0"
    port: ${DSH_PORT}
PATCHEOF
    chmod 644 "${DSH_HOME}/profiles/web/cordis.patch.yml" 2>/dev/null
    # 构建 /api browser-trust fence 的 trusted-host 列表:
    # dsh 只信任回环地址或 --trusted-host 声明的 authority, 否则局域网访问 API 全 403.
    # 把本机所有非回环 IPv4 (局域网/Tailscale 等) 都加入信任, 允许从这些地址直连访问 API.
    # 注意: dsh 的 --trusted-host <authority...> 是 variadic (一个 flag 带多个值),
    # 重复的 --trusted-host flag 会被 commander 后者覆盖, 只保留最后一个. 所以必须用单个
    # --trusted-host 拼所有值 (空格分隔).
    TRUSTED_HOST_VALUES=""
    LAN_IPS="$(ip -4 addr show 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}' | grep -v '^127\\.' || true)"
    for ip in ${LAN_IPS}; do
        TRUSTED_HOST_VALUES="${TRUSTED_HOST_VALUES} ${ip}"
    done
    # 内置默认 trusted-host: fnos.net (FN Connect 域名) + 本机非回环 IP.
    TRUSTED_HOST_VALUES="${TRUSTED_HOST_VALUES} fnos.net"
    # 读取用户配置的 FN Connect 域名 (FN ID), 每行一个, 追加.
    # 配置在 ${DSH_HOME}/trusted_hosts.conf, 与 proxy.conf 机制一致; # 开头为注释.
    # 自动清理: 去掉 http(s):// 前缀与结尾 /, 否则非法条目会让整个 trustedHosts 加载失败 → 全 403.
    if [ -f "${DSH_HOME}/trusted_hosts.conf" ]; then
        while IFS= read -r raw_host; do
            host="$(printf '%s' "${raw_host}" | sed -e 's#^https\?://##' -e 's#/$##' -e 's/[[:space:]]//g')"
            [ -z "${host}" ] && continue
            case "${host}" in \#*) continue;; esac
            TRUSTED_HOST_VALUES="${TRUSTED_HOST_VALUES} ${host}"
        done < "${DSH_HOME}/trusted_hosts.conf"
    fi
    TRUSTED_HOST_VALUES="$(printf '%s' "${TRUSTED_HOST_VALUES}" | tr -s ' ' | sed 's/^ *//;s/ *$//')"
    # 兜底: 若未探测到, 至少信任回环
    [ -z "${TRUSTED_HOST_VALUES}" ] && TRUSTED_HOST_VALUES="127.0.0.1"
    TRUSTED_HOST_ARGS="--trusted-host ${TRUSTED_HOST_VALUES}"
    # 放宽 dsh 特权 API (/api/settings.* 等) 的回环钉扎:
    # 上游对 PRIVILEGED_METHODS 硬编码只信回环, 局域网直连 API 全 403.
    # 幂等 patch dsh-client-connection, 让特权 API 也用 --trusted-host 列表.
    # 多路径定位 CC_LIB (DSH_JS 可能因软链/部署差异为空, 直接探测 node_modules 位置)
    CC_LIB=""
    for cand in \
        "$(dirname "$(dirname "${DSH_JS}")")/dsh-client-connection/lib/index.js" \
        "${APP_DIR}/target/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "${APP_DIR}/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "${APP_VOL}/@appcenter/deepseek-harness/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "${APP_VOL}/@appcenter/dsh/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "/vol4/@appcenter/deepseek-harness/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" \
        "/vol4/@appcenter/dsh/server/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js"; do
        [ -f "$cand" ] && CC_LIB="$cand" && break
    done
    if [ -n "${CC_LIB}" ]; then
        # patch 结果落 app.log (远程可诊断, 否则只打 stdout 装完即丢)
        patch_out=$(/usr/bin/python3 - "${CC_LIB}" <<'PATCHPY'
import sys
p = sys.argv[1]
s = open(p, encoding="utf-8").read()
changed = False
old1 = 'PRIVILEGED_METHODS.has(method) && !isTrustedApiRequest(request, []))'
new1 = 'PRIVILEGED_METHODS.has(method) && !isTrustedApiRequest(request, trustedHosts))'
if old1 in s and new1 not in s:
    s = s.replace(old1, new1); changed = True
old2 = 'if (interceptor.options.authority == "loopback" && !isTrustedApiRequest(request, []))'
old2b = 'if (interceptor.options.authority === "loopback" && !isTrustedApiRequest(request, []))'
new2 = 'if (interceptor.options.authority === "loopback" && !isTrustedApiRequest(request, this.trustedHosts))'
if old2b in s and new2 not in s:
    s = s.replace(old2b, new2); changed = True
elif old2 in s and new2 not in s:
    s = s.replace(old2, new2); changed = True
old3 = 'const trustedHosts = options.authority === "loopback" ? [] : this.trustedHosts;'
new3 = 'const trustedHosts = this.trustedHosts;'
if old3 in s and new3 not in s:
    s = s.replace(old3, new3); changed = True
# 浏览器鉴权放行: dsh web 启动铸一次性 launch token (打印在日志), 浏览器凭
# GET /?token= 换 30 天 authority 绑定 cookie; 裸开 / 无 cookie 即 401
# "authentication required; reopen the URL printed by dsh web" — fpk 桌面入口
# 是静态 URL, 每次重启 token 都变, 用户没法感知. 放行依据: Host/Origin 信任
# 围栏 (api-request-trust, 403) 在鉴权 (401) 之前执行, 能走到鉴权的请求必然
# 已属于 loopback / --trusted-host 白名单 — 与上面特权 API 放行是同一信任决策.
old4 = "isAuthenticated(request) {\n\t\tconst authority = requestAuthority(request.headers);"
new4 = "isAuthenticated(request) {\n\t\treturn true; /* fnos-fpk: browser token auth off, host/origin trust fence is the gate */\n\t\tconst authority = requestAuthority(request.headers);"
if old4 in s and new4 not in s:
    s = s.replace(old4, new4); changed = True
if changed:
    open(p, "w", encoding="utf-8").write(s)
    print("privileged-fence patched" if new1 in s or new2 in s else "privileged-fence already patched", end="")
    print(" + browser-auth bypassed" if new4 in s else " + browser-auth patch FAILED (pattern mismatch)")
elif "isTrustedApiRequest(request, this.trustedHosts)" in s or "isTrustedApiRequest(request, trustedHosts)" in s:
    print("privileged-fence native in upstream (>=0.1.2), no patch needed")
else:
    print("privileged-fence already patched")
if new4 in s:
    print("browser-auth: token auth off (trust fence only); launch-token URLs still redirect to clean /")
elif old4 in s:
    print("WARNING: browser-auth patch did not apply — desktop entry will 401 until token URL visited")
PATCHPY
2>&1)
        # python3 不可用/失败时用 node 兜底 (dsh 硬依赖 nodejs_v24, 必存在);
        # 部分 fnOS 环境 /usr/bin/python3 缺失曾致补丁静默失败 → 桌面 401
        if [ -z "$patch_out" ] || echo "$patch_out" | grep -qi "error\|traceback\|not found"; then
            log "privileged-fence patch: python3 不可用或失败, 尝试 node 兜底"
            patch_out=$("${NODE_BIN:-node}" -e '
const fs = require("fs");
const p = process.argv[1];
let s = fs.readFileSync(p, "utf8"), changed = false;
const reps = [
  ["PRIVILEGED_METHODS.has(method) && !isTrustedApiRequest(request, []))",
   "PRIVILEGED_METHODS.has(method) && !isTrustedApiRequest(request, trustedHosts))"],
  ["if (interceptor.options.authority === \"loopback\" && !isTrustedApiRequest(request, []))",
   "if (interceptor.options.authority === \"loopback\" && !isTrustedApiRequest(request, this.trustedHosts))"],
  ["const trustedHosts = options.authority === \"loopback\" ? [] : this.trustedHosts;",
   "const trustedHosts = this.trustedHosts;"],
  ["isAuthenticated(request) {\n\t\tconst authority = requestAuthority(request.headers);",
   "isAuthenticated(request) {\n\t\treturn true; /* fnos-fpk: browser token auth off, host/origin trust fence is the gate */\n\t\tconst authority = requestAuthority(request.headers);"]
];
for (const [o, n] of reps) { if (s.includes(o) && !s.includes(n)) { s = s.split(o).join(n); changed = true; } }
if (changed) { fs.writeFileSync(p, s); console.log("node fallback: patched"); }
else if (reps.some(([,n]) => s.includes(n)) || s.includes("fnos-fpk: browser token auth off")) console.log("already patched");
else console.log("WARNING: no pattern matched (upstream code changed?)");
' "${CC_LIB}" 2>&1)
        fi
        log "privileged-fence patch: ${patch_out:-no output}"
    else
        log "privileged-fence patch: SKIP (dsh-client-connection/lib/index.js 未找到, CC_LIB 定位失败 — 检查安装布局)"
    fi
    # 启动 dsh web: 不带 --host (让 patch 的 0.0.0.0 生效), 显式传 --port + trusted-host
    # DSH_ARGS 非空时 = 用 node <bin.js> 运行 (无 bin 链接的兜底)
    # dsh 自托管 node: 把 nodejs_v24 bin 目录加入 PATH, 供 dsh 进程及 agent 调用 node/npm
    if [ -n "${NODE_BIN}" ]; then
        NODE_BIN_DIR="$(dirname "${NODE_BIN}" 2>/dev/null)"
        case ":${PATH}:" in
            *":${NODE_BIN_DIR}:"*) : ;;
            *) export PATH="${NODE_BIN_DIR}:${PATH}" ;;
        esac
        # corepack shims (pnpm/yarn) 加入 PATH: nodejs_v24 的 corepack 提供 pnpm 命令,
        # 供 dsh agent 环境直接调用. shims 位于 <prefix>/lib/node_modules/corepack/shims
        for cand in \
            "$(dirname "${NODE_BIN_DIR}")/lib/node_modules/corepack/shims" \
            "${NODE_BIN_DIR}/lib/node_modules/corepack/shims"; do
            if [ -d "${cand}" ]; then
                case ":${PATH}:" in
                    *":${cand}:"*) : ;;
                    *) export PATH="${cand}:${PATH}" ;;
                esac
                # 固定 pnpm 版本 + 缓存目录放数据区 (避免每次重下, 也避免占用系统盘)
                export COREPACK_HOME="${DSH_HOME}/.corepack" 2>/dev/null || true
                export COREPACK_DEFAULT_TO_LATEST=0
                log "corepack shims: ${cand} (pnpm available, COREPACK_HOME=${DSH_HOME}/.corepack)"
                break
            fi
        done
        # npm 全局 prefix 指向数据区: 避免读到 /home/<user>/.npmrc 的 prefix 导致
        # "config prefix cannot be changed from project config" 且全局安装落系统盘.
        mkdir -p "${DSH_HOME}/.npm-global" 2>/dev/null || true
        export npm_config_prefix="${DSH_HOME}/.npm-global"
        export npm_config_cache="${DSH_HOME}/.npm" 2>/dev/null || true
        log "npm prefix -> ${DSH_HOME}/.npm-global (数据区)"
        # bun (fnOS 依赖应用 bunjs): 把 bin 加入 PATH, 供 dsh agent 环境调用
        for cand in /var/apps/bunjs/target/bin "${APP_VOL:-}/@appcenter/bunjs/bin"; do
            if [ -x "${cand}/bun" ]; then
                case ":${PATH}:" in
                    *":${cand}:"*) : ;;
                    *) export PATH="${cand}:${PATH}" ;;
                esac
                log "bun available via: ${cand}/bun"
                break
            fi
        done
        log "dsh self-hosting node via: ${NODE_BIN}"
    fi
    DSH_HOME="${DSH_HOME}" nohup "${DSH_BIN}" ${DSH_ARGS:-} web --port "${DSH_PORT}" ${TRUSTED_HOST_ARGS} \
        >> "${DSH_LOG}" 2>&1 &
    echo $! > "${DSH_PID}"
    log "dsh web started (pid $(cat "${DSH_PID}")) :0.0.0.0:${DSH_PORT} (patch: host 0.0.0.0) trusted-host:${TRUSTED_HOST_VALUES}"
    sleep 3
    # 落盘带 token 的访问 URL (参考/应急): 启动日志形如
    #   dsh web: http://127.0.0.1:28000/?token=… (LAN: http://192.168.x.x:28000/?token=…)
    # 浏览器鉴权已被 fpk patch 关闭(信任围栏兜底), 平时无需此文件; dsh 重启后 token 会变,
    # 这里始终抓最后一次启动的输出.
    ( sleep 6
      URL_LINE="$(grep -o 'dsh web: .*' "${DSH_LOG}" 2>/dev/null | tail -1 || true)"
      if [ -n "${URL_LINE}" ]; then
          printf '%s\n' "${URL_LINE#dsh web: }" > "${DATA_DIR}/dsh-web-url.txt"
          log "web url (token) -> ${DATA_DIR}/dsh-web-url.txt"
      else
          log "no launch-token URL in log (browser-auth patch active, expected on later runs)"
      fi
    ) &
}

# 启动统一网关代理 (Unix socket → 127.0.0.1:DSH_PORT)
start_proxy() {
    [ -f "${PROXY_SRC}" ] || { log "proxy.py not found (${PROXY_SRC})"; return 0; }
    if [ -f "${PROXY_PID}" ] && kill -0 "$(cat "${PROXY_PID}")" 2>/dev/null; then
        return 0
    fi
    PY=/usr/bin/python3
    DSH_PORT="${DSH_PORT}" SOCK_PATH="${SOCK_PATH}" \
      nohup "${PY}" "${PROXY_SRC}" >> "${PROXY_LOG}" 2>&1 &
    echo $! > "${PROXY_PID}"
    log "proxy started (pid $(cat "${PROXY_PID}")) ${SOCK_PATH} -> 127.0.0.1:${DSH_PORT}"
    sleep 1
}

start() {
    mkdir -p "${DATA_DIR}" "${DSH_HOME}"
    find_dsh_bin
    start_dsh
    start_proxy
    # 健康检查
    sleep 2
    if [ -f "${DSH_PID}" ] && kill -0 "$(cat "${DSH_PID}")" 2>/dev/null; then
        log "dsh health OK"
        return 0
    else
        log "dsh failed to start (check ${DSH_LOG})"
        return 1
    fi
}

stop() {
    # 停 proxy 再停 dsh
    if [ -f "${PROXY_PID}" ]; then
        kill "$(cat "${PROXY_PID}")" 2>/dev/null
        rm -f "${PROXY_PID}"
        log "proxy stopped"
    fi
    if [ -f "${DSH_PID}" ]; then
        kill "$(cat "${DSH_PID}")" 2>/dev/null
        rm -f "${DSH_PID}"
        log "dsh web stopped"
    fi
    return 0
}

status() {
    if [ -f "${DSH_PID}" ] && kill -0 "$(cat "${DSH_PID}")" 2>/dev/null; then
        echo "dsh web: running (pid $(cat "${DSH_PID}"))"
        return 0
    else
        echo "dsh web: stopped"
        return 1
    fi
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    *) echo "usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
