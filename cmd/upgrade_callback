#!/bin/bash
# upgrade_callback — 升级 dsh
# 离线优先: 若 fpk 内置 node_modules (app/server) 则免联网; 否则在线 npm install (针对当前架构编译).
# 升级后应用 settings 前端 patch (memory->host).
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-dsh}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
DATA_DIR="${TRIM_PKGVAR:-/vol4/@appdata/${APP_NAME}}"
LOG="${DATA_DIR}/install.log"
DSH_OFFLINE="${APP_DIR}/server/node_modules/@deepseek-ai/dsh/lib/bin.js"

echo "[$(date '+%F %T')] upgrade_callback start" >> "${LOG}"

# 检查离线 dsh 包; 若无则在线安装 (针对当前架构编译原生模块)
if [ ! -f "${DSH_OFFLINE}" ]; then
    echo "[$(date '+%F %T')] offline dsh package not found; online npm install..." >> "${LOG}"
    NPM_BIN=""
    for cand in /vol4/@appcenter/nodejs_v24/bin/npm /var/apps/nodejs_v24/target/bin/npm /usr/bin/npm; do
        [ -x "$cand" ] && NPM_BIN="$cand" && break
    done
    if [ -n "${NPM_BIN}" ]; then
        ( cd "${APP_DIR}/server" && "${NPM_BIN}" install @deepseek-ai/dsh@^0.1.0-rc.6 >> "${LOG}" 2>&1 )
        echo "[$(date '+%F %T')] online npm install exit=$?" >> "${LOG}"
    else
        echo "[$(date '+%F %T')] ERROR: no npm found; cannot install dsh online" >> "${LOG}"
    fi
else
    echo "[$(date '+%F %T')] offline dsh package OK: ${DSH_OFFLINE}" >> "${LOG}"
fi

# 应用 settings 前端 patch (memory->host), 与 install_callback 一致, 幂等
PATCH_SCRIPT="${APP_DIR}/cmd/patch_settings_memory.py"
if [ -f "${PATCH_SCRIPT}" ]; then
    echo "[$(date '+%F %T')] applying settings memory->host patch..." >> "${LOG}"
    python3 "${PATCH_SCRIPT}" >> "${LOG}" 2>&1
    echo "[$(date '+%F %T')] settings patch applied (exit=$?)" >> "${LOG}"
else
    echo "[$(date '+%F %T')] WARN: patch script not found at ${PATCH_SCRIPT}" >> "${LOG}"
fi

exit 0
