#!/bin/bash
# upgrade_callback — 升级 dsh
# 离线优先: 若 fpk 内置 node_modules (app/server) 则免联网; 否则在线 npm install (针对当前架构编译).
# 升级后应用 settings 前端 patch (memory->host).
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-dsh}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -z "${APP_VOL}" ]; then
        APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi
# APP_VOL 由 APP_DIR 提取 (同卷), 不写死 /vol4
LOG="${DATA_DIR}/install.log"
DSH_OFFLINE=""
for cand in "${APP_DIR}/target/server/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            "${APP_DIR}/server/node_modules/@deepseek-ai/dsh/lib/bin.js" \
            "${APP_DIR}/node_modules/@deepseek-ai/dsh/lib/bin.js"; do
    [ -f "$cand" ] && DSH_OFFLINE="$cand" && break
done

echo "[$(date '+%F %T')] upgrade_callback start" >> "${LOG}"

# 检查离线 dsh 包; 若无则在线安装 (针对当前架构编译原生模块)
if [ ! -f "${DSH_OFFLINE}" ]; then
    echo "[$(date '+%F %T')] offline dsh package not found; online npm install..." >> "${LOG}"
    # 定位 nodejs_v24 (优先 fnOS 标准软链 /var/apps/<dep>/target, fallback 应用卷) 并加入 PATH
    NODE_DIR=""
    for cand in /var/apps/nodejs_v24/target/bin "${APP_VOL}/@appcenter/nodejs_v24/bin"; do
        [ -x "$cand/node" ] && NODE_DIR="$cand" && break
    done
    if [ -n "${NODE_DIR}" ]; then
        export PATH="${NODE_DIR}:${PATH}"
        # 低内存设备 (R2S 等 1GB) 防 OOM: 单线程编译 + 限制 node 堆内存
        export npm_config_jobs=1
        export NODE_OPTIONS="--max-old-space-size=512"
        # npm 缓存目录: 部分用户 HOME 不存在 (如 /home/admin), 改到数据区
        mkdir -p "${DATA_DIR}/.npm" 2>/dev/null
        export HOME="${DATA_DIR}"
        ( cd "${APP_DIR}/server" && npm install @deepseek-ai/dsh@^0.1.0-rc.6 >> "${LOG}" 2>&1 )
        echo "[$(date '+%F %T')] online npm install exit=$? (node dir: ${NODE_DIR}, jobs=1, heap=512M)" >> "${LOG}"
    else
        echo "[$(date '+%F %T')] ERROR: nodejs_v24 not found; cannot install dsh online" >> "${LOG}"
    fi
else
    echo "[$(date '+%F %T')] offline dsh package OK: ${DSH_OFFLINE}" >> "${LOG}"
fi

# 应用 settings 前端 patch (memory->host), 与 install_callback 一致, 幂等
PATCH_SCRIPT="$(dirname "$0")/patch_settings_memory.py"
if [ -f "${PATCH_SCRIPT}" ]; then
    echo "[$(date '+%F %T')] applying settings memory->host patch..." >> "${LOG}"
    python3 "${PATCH_SCRIPT}" >> "${LOG}" 2>&1
    echo "[$(date '+%F %T')] settings patch applied (exit=$?)" >> "${LOG}"
else
    echo "[$(date '+%F %T')] WARN: patch script not found at ${PATCH_SCRIPT}" >> "${LOG}"
fi


# === workspace symlink creation (dsh monorepo) ===
SERVER_DIR="${APP_DIR}/target/server"
if [ -d "${SERVER_DIR}/packages" ] && [ -d "${SERVER_DIR}/node_modules" ]; then
    NM="${SERVER_DIR}/node_modules/@deepseek-ai"
    mkdir -p "${NM}"
    for f in "${SERVER_DIR}"/vendor/*/package.json "${SERVER_DIR}"/packages/*/*/package.json "${SERVER_DIR}"/apps/*/package.json; do
        [ -f "${f}" ] || continue
        name=$(grep -o '"name": *"@deepseek-ai/[^"]*"' "${f}" 2>/dev/null | head -1 | sed 's/"name": *"@deepseek-ai\///;s/"//')
        [ -z "${name}" ] && continue
        dir=$(dirname "${f}")
        target="${NM}/${name}"
        if [ ! -e "${target}" ]; then
            ln -s "../../${dir}" "${target}" 2>/dev/null
        fi
    done
    echo "[$(date '+%F %T')] workspace symlinks created: $(ls "${NM}" 2>/dev/null | wc -l)" >> "${LOG}"
fi

exit 0
